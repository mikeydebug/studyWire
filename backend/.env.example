# Server Configuration
PORT=5001

# Anakin Wire API Setup
# Grab this from your Anakin Developer Dashboard
ANAKIN_API_KEY=your_anakin_api_key_here

# Replace this with your actual Agent ID created on Anakin Wire
ANAKIN_AGENT_ID=your_single_agent_id_here

# Set to true to bypass Anakin API and return local mock data for testing
MOCK_API=false
