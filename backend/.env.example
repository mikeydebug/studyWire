# Server Configuration
PORT=5001

# Anakin Wire API Setup
# Grab this from your Anakin Developer Dashboard
ANAKIN_API_KEY=your_anakin_api_key_here

# Replace these with your actual Agent IDs created on Anakin Wire
ANAKIN_CONCEPT_AGENT_ID=agent_concept_123
ANAKIN_ANALOGY_AGENT_ID=agent_analogy_123
ANAKIN_QUIZ_AGENT_ID=agent_quiz_123
ANAKIN_PYQ_AGENT_ID=agent_pyq_123
ANAKIN_PLAN_AGENT_ID=agent_plan_123

# Set to true to bypass Anakin API and return local mock data for testing
MOCK_API=false
